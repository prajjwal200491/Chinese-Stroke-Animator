# Copy this file to .env and fill in real values for local development.
# In production (Azure App Service) set these under Settings > Configuration > Application settings.
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_SERVER=hanzi-server.database.windows.net
DB_NAME=hanzi-list
PORT=3000
# Upstream OCR endpoint (full URL). Plain HTTP is fine here because the
# browser only ever talks to our HTTPS backend, which proxies to it.
OCR_API_URL=http://8.152.204.166:8000/ocr
